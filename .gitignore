__pycache__/
.pytest_cache/
.DS_Store
.venv/
dist/
*.egg-info/
uv.lock
node_modules/
.env

# mutmut writes its result database beside the tree it mutates; it is a
# campaign byproduct, re-derived by re-running the campaign.
.mutmut-cache

# pin_check holds this while it is mutating the working tree.
.pin_check.lock

# The profile's coverage_suite_cmd writes this when run by hand. verdict-facts
# points COVERAGE_FILE at its own scratch path (harness.py), so a harness run
# leaves nothing here — a contributor reproducing the diff-coverage figure does.
.coverage
